# ── ClinicalGuard v3.0 .env ──────────────────────────────────────────────────

# ── LLM Models ───────────────────────────────────────────────────────────────
# Primary agent model — orchestrates 27 tools, function calling, structured output
HEALTHCARE_AGENT_MODEL=gemini/gemini-2.5-flash

# Verification model — independent cross-check of primary findings
VERIFIER_MODEL=gemini/gemini-2.5-flash-lite

# Google API key (required for Gemini models)
GOOGLE_API_KEY=your-google-api-key-here

# ── API key for authenticating incoming A2A requests ─────────────────────────
API_KEYS=clinicalguard-hackathon-2025

# ── Prompt Opinion platform URL ──────────────────────────────────────────────
PO_PLATFORM_BASE_URL=https://app.promptopinion.ai

# ── Public agent URL (your ngrok or deployed URL) ────────────────────────────
HEALTHCARE_AGENT_URL=https://your-tunnel.ngrok-free.dev
